    {
      "name": "Create Issue",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Очікуваний статус-код 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Парсимо відповідь і зберігаємо номер Issue\r",
              "var jsonData = pm.response.json();\r",
              "pm.environment.set(\"issue_number\", jsonData.number);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{github_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/vnd.github+json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"Automated Bug Report: Login Endpoint failing\",\r\n  \"body\": \"This issue was automatically generated via Postman API testing collection.\",\r\n  \"labels\": [\"bug\"]\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{github_url}}/repos/{{repo_owner}}/{{repo_name}}/issues",
          "host": [
            "{{github_url}}"
          ],
          "path": [
