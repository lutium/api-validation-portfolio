    {
      "name": "Create Repository",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус-код 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "// Зберігаємо логін власника (lutium)\r",
              "pm.environment.set(\"repo_owner\", jsonData.owner.login);\r",
              "\r",
              "// Зберігаємо назву репозиторію\r",
              "pm.environment.set(\"repo_name\", jsonData.name);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{github_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/vnd.github+json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"postman-qa-automation-portfolio-v2\",\r\n  \"description\": \"Automated repository created via Postman API testing\",\r\n  \"private\": true,\r\n  \"has_issues\": true\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
